# Скопируйте в .env и поправьте. Все значения необязательны.
ACADEMY_DB=./data/academy.db      # путь к файлу базы SQLite
COOKIE_SECURE=0                    # 1, когда сайт открыт по HTTPS (обязательно в продакшене)
TRUST_PROXY=0                      # 1, если сайт стоит за nginx/traefik/Caddy
ALLOW_ORG_SIGNUP=1                 # 0: запретить самостоятельное создание компаний
ALLOW_INDIVIDUAL_SIGNUP=1          # 0: регистрация только по коду компании
SESSION_DAYS=30
REVIEW_DELAY_HOURS=48              # через сколько вернуть вопрос, в котором ошиблись
MIN_GROUP=3                        # минимум людей, чтобы показывать сводку ошибок
